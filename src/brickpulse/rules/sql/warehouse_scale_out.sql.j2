{% import '_macros.sql.j2' as m with context %}
-- Rule: warehouse_scale_out  (under-provisioned warehouse — queries QUEUE at capacity)
--
-- The mirror image of warehouse_rightsize. Right-size shrinks a warehouse whose
-- queries never queue and never spill; this GROWS one whose queries wait for
-- capacity. Two different shortages, two different levers:
--   * waiting_at_capacity_duration_ms > 0  => the warehouse ran out of CLUSTERS
--     to place the query on (a CONCURRENCY shortage) -> raise max_clusters, and
--     multi-cluster load balancing spins the extra cluster up only while the
--     queue exists, then stops it. This is what this rule recommends.
--   * spilled_local_bytes > 0              => one query needed more MEMORY than a
--     node had (a per-query DATA shortage) -> size up the t-shirt. Handled as a
--     SEPARATE signal (surfaced in evidence), because in the field a queueing
--     warehouse almost never spills — the two shortages rarely coincide.
--
-- NOT a savings rule. Adding a cluster raises the bill during busy hours; it buys
-- back user wait-time and reliability, not dollars. score() books $0 savings and
-- ranks on the measured queue pain (same contract as untagged_spend).
--
-- IMPORTANT: no workspace_id filter here (persona scoping injected downstream).
WITH latest_warehouses AS (
  SELECT workspace_id, warehouse_id, warehouse_name, warehouse_type, warehouse_size,
         min_clusters, max_clusters, auto_stop_minutes
  FROM {{ tbl('compute','warehouses') }}
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY workspace_id, warehouse_id ORDER BY change_time DESC
  ) = 1
),
-- Per-warehouse query-load profile over the lookback: how much of the load waited
-- for capacity, how long it waited, and (for the size-vs-cluster distinction)
-- whether anything spilled.
load AS (
  SELECT
    -- warehouse_id is workspace-scoped; carry workspace_id so queue
    -- metrics from a same-id warehouse in another workspace cannot merge in.
    workspace_id,
    compute.warehouse_id AS warehouse_id,
    COUNT(*) AS queries,
    -- Distinct days with queries; score() suppresses rows below min_observation_days
    -- (finops_rules.history) so a single busy afternoon can't drive a finding.
    COUNT(DISTINCT CAST(start_time AS DATE)) AS observed_days,
    SUM(CASE WHEN waiting_at_capacity_duration_ms > 0 THEN 1 ELSE 0 END) AS queued_queries,
    SUM(CASE WHEN waiting_at_capacity_duration_ms > 0 THEN 1 ELSE 0 END) / COUNT(*) AS queued_pct,
    SUM(CASE WHEN spilled_local_bytes > 0 THEN 1 ELSE 0 END) / COUNT(*) AS spilled_pct,
    SUM(waiting_at_capacity_duration_ms) / 1000.0 AS total_queue_wait_s,
    PERCENTILE(waiting_at_capacity_duration_ms, 0.95) / 1000.0 AS p95_queue_wait_s,
    AVG(waiting_at_capacity_duration_ms) / 1000.0 AS avg_queue_wait_s,
    PERCENTILE(execution_duration_ms, 0.95) / 1000.0 AS p95_runtime_s,
    -- Query SHAPE, the evidence behind the "add a cluster vs. size up" fork. The
    -- rule's copy asserts a queueing warehouse "almost never spills" (so the lever
    -- is clusters, not size); these MEASURED volumes let the reader confirm it for
    -- THIS warehouse rather than take the claim on faith. /1e9 -> GB, same as
    -- warehouse_rightsize. Spill is rare on a queueing warehouse, so its p95 is
    -- usually 0 and MAX (the single worst query) is the telling number; scan and
    -- shuffle p95 characterise how heavy the queued queries actually are.
    PERCENTILE(read_bytes, 0.95) / 1e9 AS p95_read_gb,
    PERCENTILE(shuffle_read_bytes, 0.95) / 1e9 AS p95_shuffle_gb,
    MAX(spilled_local_bytes) / 1e9 AS max_spill_gb
  FROM {{ tbl('query','history') }}
  WHERE compute.warehouse_id IS NOT NULL
    AND {{ m.window_lower('start_time') }}
  GROUP BY 1, 2
),
-- Query volume by hour of day (0-23): shows WHEN the contention happens, so the
-- reader can see it is concentrated (adding a cluster only costs extra during
-- those hours) rather than round-the-clock.
by_hour AS (
  SELECT workspace_id,
         compute.warehouse_id AS warehouse_id,
         HOUR(start_time) AS hod,
         COUNT(*) AS c,
         SUM(CASE WHEN waiting_at_capacity_duration_ms > 0 THEN 1 ELSE 0 END) AS queued_c
  FROM {{ tbl('query','history') }}
  WHERE compute.warehouse_id IS NOT NULL
    AND {{ m.window_lower('start_time') }}
  GROUP BY 1, 2, 3
),
by_hour_map AS (
  SELECT workspace_id, warehouse_id,
         map_from_arrays(collect_list(hod), collect_list(c)) AS c_map,
         map_from_arrays(collect_list(hod), collect_list(queued_c)) AS q_map
  FROM by_hour
  GROUP BY 1, 2
),
hourly AS (
  -- Dense 24-element arrays (index = hour of day), filling gaps with 0. The
  -- per-hour counts are aggregated first (by_hour), collected into a map, then
  -- read back by hour: an aggregate can't reference the transform lambda var, so
  -- the map lookup does the "count for hour h" the transform needs.
  SELECT workspace_id, warehouse_id,
         transform(sequence(0, 23), h -> COALESCE(c_map[h], 0)) AS queries_by_hour,
         transform(sequence(0, 23), h -> COALESCE(q_map[h], 0)) AS queued_by_hour
  FROM by_hour_map
),
-- Peak concurrent queries per warehouse. CPU/memory alone miss
-- the real limit — a warehouse can exhaust its Spark SLOTS (its concurrency budget)
-- before hitting any CPU/memory ceiling. We measure the max number of queries
-- running at once via an event sweep: +1 at each query start, -1 at each end, a
-- running sum over time, and its max is the peak overlap. Ordering ties start-before-
-- end (delta DESC) so a query ending exactly as another starts counts as concurrent
-- (a conservative, never-undercount choice). score() divides this by the
-- ~10-queries-per-cluster heuristic to size the concurrency need.
sweep_events AS (
  SELECT workspace_id, compute.warehouse_id AS warehouse_id, start_time AS t, 1 AS delta
  FROM {{ tbl('query','history') }}
  WHERE compute.warehouse_id IS NOT NULL
    AND {{ m.window_lower('start_time') }}
    AND end_time IS NOT NULL
  UNION ALL
  SELECT workspace_id, compute.warehouse_id AS warehouse_id, end_time AS t, -1 AS delta
  FROM {{ tbl('query','history') }}
  WHERE compute.warehouse_id IS NOT NULL
    AND {{ m.window_lower('start_time') }}
    AND end_time IS NOT NULL
),
sweep_running AS (
  SELECT workspace_id, warehouse_id,
         SUM(delta) OVER (
           -- sweep concurrency per (workspace, warehouse) so two
           -- workspaces' query streams are not summed into one peak.
           PARTITION BY workspace_id, warehouse_id ORDER BY t, delta DESC
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
         ) AS running
  FROM sweep_events
),
concurrency AS (
  SELECT workspace_id, warehouse_id, MAX(running) AS peak_concurrent_queries
  FROM sweep_running
  GROUP BY 1, 2
),
cost AS (
  SELECT
    u.workspace_id,
    u.usage_metadata.warehouse_id AS warehouse_id,
    SUM(u.usage_quantity * {{ m.price_rate('lp') }}) AS cost_30d_usd,
    SUM(u.usage_quantity) AS dbus_30d,
    SUM({{ m.unpriced_dbus() }}) AS unpriced_dbus
  FROM {{ tbl('billing','usage') }} u
  {{ m.price_join('lp') }}
  WHERE {{ m.window_lower('u.usage_date') }}
    AND u.usage_metadata.warehouse_id IS NOT NULL
  GROUP BY 1, 2
)
SELECT
  w.workspace_id,
  w.warehouse_id,
  w.warehouse_name,
  w.warehouse_type,
  w.warehouse_size,
  w.min_clusters,
  w.max_clusters,
  w.auto_stop_minutes,
  l.queries,
  l.observed_days,
  l.queued_queries,
  ROUND(l.queued_pct, 4) AS queued_pct,
  ROUND(l.spilled_pct, 4) AS spilled_pct,
  ROUND(l.total_queue_wait_s, 1) AS total_queue_wait_s,
  ROUND(l.p95_queue_wait_s, 2) AS p95_queue_wait_s,
  ROUND(l.avg_queue_wait_s, 2) AS avg_queue_wait_s,
  ROUND(l.p95_runtime_s, 2) AS p95_runtime_s,
  ROUND(l.p95_read_gb, 3) AS p95_read_gb,
  ROUND(l.p95_shuffle_gb, 3) AS p95_shuffle_gb,
  ROUND(l.max_spill_gb, 3) AS max_spill_gb,
  h.queries_by_hour,
  h.queued_by_hour,
  COALESCE(cc.peak_concurrent_queries, 0) AS peak_concurrent_queries,
  COALESCE(cost.cost_30d_usd, 0) AS cost_30d_usd,
  COALESCE(cost.dbus_30d, 0) AS dbus_30d,
  COALESCE(cost.unpriced_dbus, 0) AS unpriced_dbus
FROM latest_warehouses w
-- every join keyed on (workspace_id, warehouse_id).
JOIN load l ON w.workspace_id = l.workspace_id AND w.warehouse_id = l.warehouse_id
LEFT JOIN hourly h ON w.workspace_id = h.workspace_id AND w.warehouse_id = h.warehouse_id
LEFT JOIN concurrency cc ON w.workspace_id = cc.workspace_id AND w.warehouse_id = cc.warehouse_id
LEFT JOIN cost cost ON w.workspace_id = cost.workspace_id AND w.warehouse_id = cost.warehouse_id
-- Enough queries to characterise the load, a material share queued at capacity,
-- the queued queries actually waited long enough for a human to notice (sub-second
-- "queueing" rounds to zero real wait and is not worth a bill increase), and
-- headroom to add a cluster (below the platform ceiling). score() applies the
-- observation-window gate, re-checks these, and prices $0.
WHERE l.queries >= {{ min_queries }}
  AND l.queued_pct >= {{ min_queued_pct }}
  AND l.p95_queue_wait_s >= {{ min_p95_queue_wait_s }}
  AND w.max_clusters < {{ max_clusters_ceiling }}
