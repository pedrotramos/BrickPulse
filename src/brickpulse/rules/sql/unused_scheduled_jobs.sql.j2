{% import '_macros.sql.j2' as m with context %}
-- Rule: unused_scheduled_jobs
-- Jobs that still exist (current SCD2 row, not deleted) but have not run
-- recently. We take the latest definition per (workspace_id, job_id), left join
-- a per-job last-run summary from the job_run_timeline, and left join any
-- residual 30d cost priced via list_prices. score() computes days-since-last-run
-- and emits a hygiene finding.
--
-- IMPORTANT: no workspace_id filter here. Persona scoping is injected by the
-- data layer so this same SQL serves both account-wide precompute and
-- workspace-scoped live queries.
WITH
-- Current job version: rank ALL versions, then keep the live one.
-- Filtering delete_time before ranking would resurrect an older version of a
-- since-deleted job and recommend hygiene on something already gone.
{{ m.latest_scd_cte(
     'latest_jobs',
     tbl('lakeflow','jobs'),
     'workspace_id, job_id',
     select_cols='workspace_id, job_id, name AS job_name, delete_time') }},
runs AS (
  SELECT
    workspace_id,
    job_id,
    MAX(period_end_time) AS last_run_time,  -- NOTE: verify column
    COUNT(*) AS runs_lookback
  FROM {{ tbl('lakeflow','job_run_timeline') }}  -- NOTE: verify table
  -- 90-day scheduling history (intentionally wider than the cost window), still
  -- closed-open so today's partial data does not distort "last run".
  WHERE {{ m.window_lower('period_end_time', days=90) }}
  GROUP BY 1, 2
),
{{ m.usage_cost_cte('cost', 'u.usage_metadata.job_id', 'job_id') }}
SELECT
  j.workspace_id,
  j.job_id,
  j.job_name,
  runs.last_run_time,
  COALESCE(runs.runs_lookback, 0) AS runs_lookback,
  COALESCE(cost.cost_30d_usd, 0) AS cost_30d_usd,
  COALESCE(cost.dbus_30d, 0) AS dbus_30d,
  COALESCE(cost.unpriced_dbus, 0) AS unpriced_dbus{{ m.contract_cost_select('cost', lead=True) }}
FROM latest_jobs j
LEFT JOIN runs USING (workspace_id, job_id)
LEFT JOIN cost USING (workspace_id, job_id)
